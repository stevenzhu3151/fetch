# ─────────────────────────────────────────────────────────────
#  leadgen-fetch configuration. Copy to `.env` and fill in.
#  Everything has a safe default; you can run with NO keys at all
#  (it falls back to sample data + dry-run email).
# ─────────────────────────────────────────────────────────────

# How many fresh leads to process per run.
DAILY_LIMIT=100

# Where/what to search. Comma-separated business types.
SEARCH_QUERIES=coffee shop,restaurant,bakery,boutique,barber shop
SEARCH_LOCATION=Austin, TX

# ── Data source: Google Places API (New) ──
# Get a key: https://developers.google.com/maps/documentation/places/web-service/get-api-key
# Leave blank to use built-in SAMPLE data (great for testing the pipeline).
GOOGLE_PLACES_API_KEY=

# ── Demo copy generation: Anthropic (optional) ──
# Leave blank to use template defaults (no AI cost).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Built-in web server (hosts demos + unsubscribe page + open tracking) ──
# In production point PUBLIC_BASE_URL at your server's public https URL.
PORT=8787
PUBLIC_BASE_URL=
# Override only if you host demos somewhere else (Netlify/S3). Defaults to
# PUBLIC_BASE_URL/d. Demos get a unique URL automatically: <base>/d/<id>/
DEMO_BASE_URL=
# Secret used to sign per-recipient unsubscribe links. CHANGE THIS.
UNSUB_SECRET=change-me-in-production

# ── Follow-up sequence ──
FOLLOWUP_MAX=2          # number of follow-ups after the first email
FOLLOWUP_DELAY_DAYS=3   # wait this long between touches

# ── Outreach email ──
# DRY_RUN=true (default) writes the email to data/outbox/ instead of sending.
# Set DRY_RUN=false AND EMAIL_ENABLED=true to actually send.
DRY_RUN=true
EMAIL_ENABLED=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Your Name <you@yourstudio.com>
EMAIL_REPLY_TO=

# ── Inbox scanning (reply detection + honoring opt-out replies) ──
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=

# ── CAN-SPAM compliance (REQUIRED for real sending) ──
# A real physical postal address is legally required. The unsubscribe link is
# generated per-recipient and served by the built-in server at PUBLIC_BASE_URL/u.
SENDER_BUSINESS_NAME=Acme Web Studio
SENDER_ADDRESS=123 Main St, Suite 100, Austin, TX 78701, USA
CALENDAR_URL=https://calendly.com/you/15min

# ── Scheduler cron expressions (used by `npm run schedule`) ──
SCHEDULE_CRON=0 9 * * *
FOLLOWUP_CRON=0 10 * * *
REPLIES_CRON=*/30 * * * *
