# ─────────────────────────────────────────────────────────────
#  leadgen-fetch configuration. Copy to `.env` and fill in.
#  Everything has a safe default; you can run with NO keys at all
#  (it falls back to sample data + dry-run email).
# ─────────────────────────────────────────────────────────────

# How many fresh leads to process per run.
DAILY_LIMIT=100

# Where/what to search. Comma-separated business types.
SEARCH_QUERIES=coffee shop,restaurant,bakery,boutique,barber shop
SEARCH_LOCATION=Austin, TX

# ── Data source: Google Places API (New) ──
# Get a key: https://developers.google.com/maps/documentation/places/web-service/get-api-key
# Leave blank to use built-in SAMPLE data (great for testing the pipeline).
GOOGLE_PLACES_API_KEY=

# ── Demo copy generation: Anthropic (optional) ──
# Leave blank to use template defaults (no AI cost).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Public base URL where generated demos are hosted (e.g. Netlify/S3/your server).
# Used in the outreach email link. If blank, the email shows a local path note.
DEMO_BASE_URL=

# ── Outreach email ──
# DRY_RUN=true (default) writes the email to data/outbox/ instead of sending.
# Set DRY_RUN=false AND EMAIL_ENABLED=true to actually send.
DRY_RUN=true
EMAIL_ENABLED=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Your Name <you@yourstudio.com>
EMAIL_REPLY_TO=

# ── CAN-SPAM compliance (REQUIRED for real sending) ──
# A real physical postal address and a working unsubscribe URL are legally required.
SENDER_BUSINESS_NAME=Acme Web Studio
SENDER_ADDRESS=123 Main St, Suite 100, Austin, TX 78701, USA
UNSUBSCRIBE_URL=https://yourstudio.com/unsubscribe
CALENDAR_URL=https://calendly.com/you/15min
